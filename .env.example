# 复制为 .env 后填写。请勿提交真实 Token。

# 必填：CloudDrive2 API Token
CD2_TOKEN=

# 必填：从 @BotFather 获取的 Telegram Bot Token
TG_TOKEN=

# 必填：允许使用机器人的 Telegram 数字用户 ID，多个用逗号分隔
ADMIN_IDS=

# CloudDrive2 gRPC 地址。Compose 使用 host 网络，可直接访问本机端口
CD2_ADDRESS=127.0.0.1:19798

# 离线下载保存路径（这是 CloudDrive2 内部能识别的路径）
SAVE_PATH=/115/离线下载

# 小于该体积的文件会被清理，单位 MB
SIZE_THRESHOLD=300

# 可选：Telegram 网络代理；不需要代理时留空
PROXY_URL=http://192.168.31.10:7890

# 网络异常静默多久后重新计数，单位秒
NETWORK_ERROR_RESET_SECONDS=300

# 是否启用定时自动清理；设为 false 时仍可手动执行 /clean
CLEAN_ENABLED=true

# 定时清理 Cron 表达式
CLEAN_CRON='30 3 * * *'

# JavBoss 专属待验收目录。请先在 115 中手工创建；程序不会自动改动
# “云下载”根目录，/clean 也不会清理该目录以外的内容。
JAV_STAGING_PATH=/115/云下载/jav待验收

# 质量验收通过后才移动到正式作品库；JavBoss 只扫描正式目录。
JAV_LIBRARY_PATH=/115/upload/javbosstest

# JavBoss 调用本 Bot 下载网关的本机 HTTP 地址和共享密钥。
GATEWAY_HOST=127.0.0.1
GATEWAY_PORT=18081
JAVBOSS_GATEWAY_TOKEN=

# 下载任务、幂等键及失败回调的持久化位置。
INTEGRATION_STATE_DB=/app/data/integration.db

# Bot 的 /jav 输入及下载状态回调所用 JavBoss 地址和独立密钥。
JAVBOSS_BASE_URL=http://127.0.0.1:17654
JAVBOSS_INPUT_TOKEN=
JAVBOSS_CALLBACK_TOKEN=

JAV_DOWNLOAD_POLL_SECONDS=30
JAV_CALLBACK_RETRY_SECONDS=30
