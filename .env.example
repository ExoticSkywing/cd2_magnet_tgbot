# 复制为 .env 后填写。请勿提交真实 Token。

# 必填：CloudDrive2 API Token
CD2_TOKEN=

# 必填：从 @BotFather 获取的 Telegram Bot Token
TG_TOKEN=

# 必填：允许使用机器人的 Telegram 数字用户 ID，多个用逗号分隔
ADMIN_IDS=

# CloudDrive2 gRPC 地址。CD2 使用 host 网络时，通过主机网关访问
CD2_ADDRESS=host.docker.internal:19798

# 离线下载保存路径（这是 CloudDrive2 内部能识别的路径）
SAVE_PATH=/115/离线下载

# 小于该体积的文件会被清理，单位 MB
SIZE_THRESHOLD=300

# 可选：Telegram 网络代理；不需要代理时留空
PROXY_URL=http://192.168.31.10:7890

# 网络异常静默多久后重新计数，单位秒
NETWORK_ERROR_RESET_SECONDS=300

# 定时清理 Cron 表达式
CLEAN_CRON=30 3 * * *
